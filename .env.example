DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clothes_shop?schema=public"

ADMIN_USERNAME="admin"
# Generate with: node scripts/generate-admin-hash.mjs <password>
# IMPORTANT: Next.js expands $VAR inside .env files, and bcrypt hashes are full of "$".
# Escape every "$" as "\$" or the hash will get silently truncated.
ADMIN_PASSWORD_HASH=""
