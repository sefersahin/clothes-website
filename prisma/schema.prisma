// Prisma schema for the Instagram Shop → standalone e-commerce site.
// See project-overview.md sections 9 (Data Model) and 12 (Admin Authentication).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  accepted
  preparing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  awaiting
  paid
  refunded
}

enum SizeChartType {
  dress
  shirt
  skirt
  suit
  pants
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  basePrice   Decimal       @db.Decimal(10, 2)
  salePrice   Decimal?      @db.Decimal(10, 2)
  status      ProductStatus @default(draft)
  categoryId  String?
  color       String?
  groupId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group           ProductGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  images          ProductImage[]
  sizeChartRows   SizeChartRow[]
  featuredProduct FeaturedProduct?

  @@map("products")
}

model ProductGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  products Product[]

  @@map("product_groups")
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  sizeChartType SizeChartType @default(dress)
  isAllProducts Boolean       @default(false)
  createdAt     DateTime      @default(now())

  products   Product[]
  heroSlides HeroSlide[]

  @@map("categories")
}

model MarqueeSetting {
  id        String   @id @default(cuid())
  text      String
  updatedAt DateTime @updatedAt

  @@map("marquee_settings")
}

model HeroSlide {
  id         String   @id @default(cuid())
  imageUrl   String
  publicId   String
  categoryId String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("hero_slides")
}

model FeaturedProduct {
  id        String   @id @default(cuid())
  productId String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("featured_products")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  size          String
  stockQuantity Int     @default(0)
  sku           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@map("product_variants")
}

model SizeChartRow {
  id        String  @id @default(cuid())
  productId String
  size      String
  neck      String?
  chest     String?
  waist     String?
  hip       String?
  length    String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("size_chart_rows")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  imageUrl  String
  publicId  String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Order {
  id            String        @id @default(cuid())
  orderToken    String        @unique
  customerId    String?
  customerName  String
  phone         String
  email         String?
  province      String
  district      String
  addressLine   String
  postalCode    String
  addressNotes  String?
  status        OrderStatus   @default(accepted)
  paymentStatus PaymentStatus @default(awaiting)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productName String
  size        String
  color       String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions CustomerSession[]
  orders   Order[]

  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_sessions")
}
